# Immutable Linux/amd64 external-oracle inputs for scripts/run-competitive-oracles.sh.
#
# These are platform manifests, not mutable tags. Update a version only with a
# corresponding compatibility review and a retained campaign showing the old
# and new oracle behaviour. ClickHouse additionally records the local image ID
# because the legacy RowBinary acceptance harness deliberately runs by image ID.

CLICKHOUSE_PULL_IMAGE=clickhouse/clickhouse-server@sha256:1e108ceeaa1c5d46ee1423e9b56f960b25305319e9440fddf1d8fa616a16fc6a
