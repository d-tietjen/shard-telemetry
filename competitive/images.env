CLICKHOUSE_VERSION=26.3.17.56

PROMETHEUS_IMAGE=prom/prometheus@sha256:6573196e5dbe834779ac4d34cb053113cc502a69e9e20ba3be96d37f33e81545
PROMETHEUS_VERSION=3.7.3

LOKI_IMAGE=grafana/loki@sha256:800ec439ed2692b79c5a1fe17a6d2955f8999ad5d05f0276c6e4a10ac11cc491
LOKI_VERSION=3.7.2

TEMPO_IMAGE=grafana/tempo@sha256:9b89af53103f8ea7ee19e33951c82f826b8c873baf89cf04d49c69fed76b737e
