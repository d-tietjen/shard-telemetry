#!/usr/bin/env bash
set -euo pipefail

if [[ -f "${ST_ENGINE_DATA_DIR:?ST_ENGINE_DATA_DIR must be set}/pid" ]]; then
    pid=$(cat "$ST_ENGINE_DATA_DIR/pid")
    if kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid" 2>/dev/null || true
        for _ in $(seq 1 120); do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.25
        done
    fi
    rm -f "$ST_ENGINE_DATA_DIR/pid"
fi
